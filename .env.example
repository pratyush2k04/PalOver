# Local `docker compose up` convenience only. Copy this file to `.env` (gitignored) and
# fill in real values. NOT used by the managed-server deployment — there, the hosting
# platform injects these same variable names directly into the running container.
#
# There is no Postgres container in this compose file. Point ConnectionStrings__DefaultConnection
# at whatever Postgres you're using locally (a native install, or one running in another
# container). From inside the "app" container, reach a Postgres running on your host machine
# via "host.docker.internal" instead of "localhost".

ConnectionStrings__DefaultConnection=Host=host.docker.internal;Port=5432;Database=pdrDB;Username=postgres;Password=changeme

JwtSettings__SecretKey=dev-only-change-me
