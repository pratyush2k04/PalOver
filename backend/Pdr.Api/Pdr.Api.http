##############################################################
#################### ADMIN ENDPOINTS #########################
##############################################################

### Current Draft
GET {{host}}/api/checklist/current-draft
Authorization: Bearer {{adminToken}}

### Debug Claims
GET {{host}}/api/checklist/claims
Authorization: Bearer {{adminToken}}
Accept: application/json

### Published Version
GET {{host}}/api/checklist/published
Authorization: Bearer {{adminToken}}

###

### Version History
GET {{host}}/api/checklist/versions
Authorization: Bearer {{adminToken}}

###

### Version By Id
GET {{host}}/api/checklist/versions/2
Authorization: Bearer {{adminToken}}

###

### Categories
GET {{host}}/api/checklist/categories
Authorization: Bearer {{adminToken}}

###

### Create Item
POST {{host}}/api/checklist/items
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Conduct Kickoff Meeting",
  "description": "Conduct the initial project kickoff meeting.",
  "categoryId": 1,
  "isMandatory": true,
  "displayOrder": 1
}

###

### Update Item
PUT {{host}}/api/checklist/items/1
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Conduct Project Kickoff Meeting",
  "description": "Updated description",
  "categoryId": 1,
  "isMandatory": true,
  "displayOrder": 1
}

###

### Reorder Items
PUT {{host}}/api/checklist/items/reorder
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "items": [
    {
      "itemId": 1,
      "displayOrder": 2
    },
    {
      "itemId": 2,
      "displayOrder": 1
    }
  ]
}

###

### Retire Item
PUT {{host}}/api/checklist/items/1/retire
Authorization: Bearer {{adminToken}}

###

### Publish Version
POST {{host}}/api/checklist/versions/2/publish
Authorization: Bearer {{adminToken}}

##############################################################
##################### PM ENDPOINTS ###########################
##############################################################

### Published Version (Should Succeed)
GET {{host}}/api/checklist/published
Authorization: Bearer {{pmToken}}

###

### Current Draft (Should Return 403)
GET {{host}}/api/checklist/current-draft
Authorization: Bearer {{pmToken}}

##############################################################
###################### NO TOKEN ##############################
##############################################################

### Unauthorized
GET {{host}}/api/checklist/current-draft

##############################################################
#################### INVALID TOKEN ###########################
##############################################################

### Invalid JWT
GET {{host}}/api/checklist/current-draft
Authorization: Bearer invalid-token