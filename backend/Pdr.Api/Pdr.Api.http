##############################################################
#################### ADMIN ENDPOINTS #########################
##############################################################

### Admin Get Home
GET {{host}}/api/home
Authorization: Bearer {{adminToken}}
Accept: application/json

### Non Admin Get Home
GET {{host}}/api/home
Authorization: Bearer {{token}}
Accept: application/json

### Current Draft
GET {{host}}/api/masterchecklist/current-draft
Authorization: Bearer {{adminToken}}

### Published Version
GET {{host}}/api/masterchecklist/published
Authorization: Bearer {{adminToken}}

### 14. Add New Engagement (Mark SOW Signed - Pre Sales Role)
POST {{host}}/api/Engagements/mark-sow-signed
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "clientName": "Acme Global Solutions",
  "engagementDescription": "Enterprise LMS Implementation",
  "engagementName": "wrgbwetb",
  "engagementTypeId": 1,
  "commercialModelId": 1,
  "kickoffDate": "2026-08-15",
  "billingStartDate": "2026-09-01"
}
### Version History
GET {{host}}/api/masterchecklist/versions
Authorization: Bearer {{adminToken}}

### Version By Id
GET {{host}}/api/masterchecklist/versions/1
Authorization: Bearer {{adminToken}}

### Categories
GET {{host}}/api/masterchecklist/categories
Authorization: Bearer {{adminToken}}

### Create Item
POST {{host}}/api/masterchecklist/items
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Conduct Kickoff Meeting",
  "description": "Conduct the initial project kickoff meeting.",
  "categoryId": 1,
  "isMandatory": true,
  "displayOrder": 1
}

### Update Item
PUT {{host}}/api/masterchecklist/items/41
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Meow",
  "description": "Updated description",
  "categoryId": 1,
  "isMandatory": true,
  "displayOrder": 1
}

### Reorder Items
PUT {{host}}/api/masterchecklist/items/reorder
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "items": [
    {
      "itemId": 1,
      "displayOrder": 2
    },
    {
      "itemId": 2,
      "displayOrder": 1
    }
  ]
}

### Retire Item
PUT {{host}}/api/masterchecklist/items/41/retire
Authorization: Bearer {{adminToken}}

### Publish Version
POST {{host}}/api/masterchecklist/versions/1/publish
Authorization: Bearer {{adminToken}}

##############################################################
##################### PM ENDPOINTS ###########################
##############################################################

### Published Version (Should Succeed)
GET {{host}}/api/masterchecklist/published
Authorization: Bearer {{token}}

### Current Draft (Should Return 403)
GET {{host}}/api/masterchecklist/current-draft
Authorization: Bearer {{pmToken}}

##############################################################
###################### NO TOKEN ##############################
##############################################################

### Unauthorized
GET {{host}}/api/masterchecklist/current-draft

##############################################################
#################### INVALID TOKEN ###########################
##############################################################

### Invalid JWT
GET {{host}}/api/masterchecklist/current-draft
Authorization: Bearer invalid-token

##############################################################
################# ENGAGEMENT ENDPOINTS #######################
##############################################################

### 10. Get Engagement Types Lookup
GET {{host}}/api/EngagementTypes
Accept: application/json

### 11. Get Commercial Models Lookup
GET {{host}}/api/CommercialModels
Accept: application/json

### 12. Get My Engagements (Project Manager)
GET {{host}}/api/Engagements/my-engagements?sortBy=kickoff
Authorization: Bearer {{pmToken}}
Accept: application/json

### 13. Get Engagement Info by ID
GET {{host}}/api/Engagements/1
Authorization: Bearer {{pmToken}}
Accept: application/json

### 14. Add New Engagement (Mark SOW Signed - Pre Sales Role)
POST {{host}}/api/Engagements/mark-sow-signed
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "clientName": "Acme Global Solutions",
  "engagementDescription": "Enterprise LMS Implementation",
  "engagementTypeId": 1,
  "commercialModelId": 1,
  "kickoffDate": "2026-08-15",
  "billingStartDate": "2026-09-01"
}

### 15. Add New Engagement (Validation Failure: Billing Before Kickoff)
POST {{host}}/api/Engagements/mark-sow-signed
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "clientName": "Acme Global Solutions",
  "engagementDescription": "Test invalid billing date scenario",
  "engagementTypeId": 1,
  "commercialModelId": 1,
  "kickoffDate": "2026-08-15",
  "billingStartDate": "2026-08-01"
}

### 16. Edit Engagement Info
PUT {{host}}/api/Engagements/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
  "clientName": "Acme Global Solutions - Updated",
  "engagementDescription": "Updated description for Enterprise LMS Implementation",
  "engagementTypeId": 1,
  "commercialModelId": 1,
  "kickoffDate": "2026-08-15",
  "billingStartDate": "2026-09-01"
}
